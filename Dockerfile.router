# The runtime supplies the listener shim and shared libraries. Import it first.
ARG ROUTER_RUNTIME_IMAGE=router:vllm-yyf
ARG RUST_BUILD_IMAGE=rust:1.99.1-bookworm
FROM ${RUST_BUILD_IMAGE} AS rust-builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    cmake \
    protobuf-compiler \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Rust source files (wit/ is required by wasmtime bindgen in wasm_middleware)
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY wit ./wit

# Build the Rust binary
ARG CARGO_BUILD_JOBS=4
RUN cargo build --release --locked -j "$CARGO_BUILD_JOBS"

# Python stage with Rust binary
FROM ${ROUTER_RUNTIME_IMAGE}

# Create app directory
WORKDIR /app

# Copy the Rust binary from builder stage
COPY --from=rust-builder /app/target/release/vllm-router /usr/local/bin/vllm-router

# Make it executable
RUN chmod +x /usr/local/bin/vllm-router

# Copy Python source files for Python launcher (optional)
COPY py_src ./py_src
COPY pyproject.toml ./
COPY README.md ./

RUN test -r /usr/local/lib/router-listener.so

# Expose default router port
EXPOSE 8080

# Expose default metrics port
EXPOSE 29000

# Default command to run the router using Rust binary directly
CMD ["vllm-router", "--host", "0.0.0.0", "--port", "8080"]
